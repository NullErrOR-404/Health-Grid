# ==============================================================================
# HealthGrid — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (for local dev) or configure these in the Vercel Dashboard
# under Settings -> Environment Variables.

# Supabase Realtime Database & Secure Authentication
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# CARTO GIS & Leaflet Healthcare Basemaps
VITE_CARTO_API_KEY=your_carto_vector_tiles_api_key

# AI Clinical Intelligence Engines (DocBot AGI)
VITE_GEMINI_API_KEY=your_google_gemini_api_key
VITE_GROQ_API_KEY=your_groq_lpu_fast_inference_api_key
VITE_HF_API_KEY=your_huggingface_user_access_token
VITE_HF_FINE_TUNED_MODEL=your_username/healthgrid-clinical-llama-3.1-8b

# Optional: Production Canonical URL
VITE_SITE_URL=https://healthgrid.vercel.app
